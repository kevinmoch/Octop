{
  "agentRuntime": {
    "agentCapabilities": {
      "skillGeneration": true,
      "generativeUi": true,
      "delegation": true
    },
    "multimodal": {
      "imageAttachments": true,
      "pageImageCapture": true
    }
  },
  "sandbox": {
    "downloadedFiles": true,
    "uploadFiles": true,
    "documentSurface": true
  },
  "mcp": {
    "endpoints": [
      {
        "name": "welink-mcp-server",
        "url": "http://127.0.0.1:8162/mcp",
        "transport": "streamable-http",
        "enabled": true,
        "allowHttp": true,
        "allowPrivateHosts": true
      }
    ]
  },
  "quickPrompts": {
    "limit": 8,
    "items": [
      {
        "id": "qp-summarize",
        "text": {
          "zh": "总结当前页面",
          "en": "Summarize this page"
        },
        "icon": "page"
      },
      {
        "id": "qp-skills",
        "text": {
          "zh": "有哪些可用技能？",
          "en": "What skills are available?"
        },
        "icon": "list"
      }
    ]
  },
  "privacy": {
    "userProfile": false
  }
}
